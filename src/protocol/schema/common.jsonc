// ===== 协议 schema 定义：common.jsonc =====
// 纯 docs-first：本文件为唯一手写源头（协议零漂移红线，src/protocol/schema/ 下
// 4 文件共同构成协议定义）。程序用的 schema 对象由它自动生成（scripts/ 生成
// 流水线），生成产物不得手改；改消息格式 = 改这里 → 重新生成 → 同步提交。
// 本文件 = 跨帧共享的基础类型（client/server/board 三文件经 $defs 引用）。
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    // 角色摘要（join 响应 available_characters 成员 / 成员通知 character 字段）。
    "CharacterSummary": {
      "type": "object",
      "required": ["character_id", "name", "description"],
      "properties": {
        "character_id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    // 在线角色（group_chat_state 的 members 成员；is_self = 本 session 身份）。
    "OnlineCharacter": {
      "type": "object",
      "required": ["character_id", "name", "description", "is_self", "is_streaming", "hand_raised"],
      "properties": {
        "character_id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "is_self": { "type": "boolean" },
        "is_streaming": { "type": "boolean" },
        "hand_raised": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    // 请求/响应必带 id（仅 update_character_state 为无 id notification；服务端
    // 通知同样无 id——由各自 schema 形状区分）。无 id 的 request/response 一律
    // fail-close。id = string | number（JSON-RPC 2.0 标准；vscode-jsonrpc
    // 库 sendRequest 自增数字 id，手写握手用 string——双兼容）。
    "RequestId": {
      "anyOf": [{ "type": "string" }, { "type": "integer" }]
    },
    // JSON-RPC 错误对象：code = 业务 10 码（-32100..-32109）+ 库标准码
    // （-32700/-32600..-32603，vscode-jsonrpc 库本端生成）；未知 code = schema
    // fail-close。message = 文案原样保留。
    "ProtocolErrorObject": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "anyOf": [
            { "type": "number", "const": -32100 },
            { "type": "number", "const": -32101 },
            { "type": "number", "const": -32102 },
            { "type": "number", "const": -32103 },
            { "type": "number", "const": -32104 },
            { "type": "number", "const": -32105 },
            { "type": "number", "const": -32106 },
            { "type": "number", "const": -32107 },
            { "type": "number", "const": -32108 },
            { "type": "number", "const": -32109 },
            { "type": "number", "const": -32110 },
            { "type": "number", "const": -32111 },
            { "type": "number", "const": -32700 },
            { "type": "number", "const": -32600 },
            { "type": "number", "const": -32601 },
            { "type": "number", "const": -32602 },
            { "type": "number", "const": -32603 }
          ]
        },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    // 空成功响应 result（character_ready / leave_group_chat）。
    "NullResult": {
      "type": "null"
    },
    // 轮次快照（发言上限/已用/剩余；消息与 speak 响应内嵌）。
    "RoundSnapshot": {
      "type": "object",
      "required": ["round_max_messages", "used_messages", "remaining_messages"],
      "properties": {
        "round_max_messages": { "type": "integer", "minimum": 0 },
        "used_messages": { "type": "integer", "minimum": 0 },
        "remaining_messages": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
