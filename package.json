{
	"name": "pi-tavern",
	"version": "0.0.0",
	"private": true,
	"description": "Local group chat for independent pi coding agent sessions",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "vitest --run",
		"test:acceptance": "PITAVERN_TEST=1 vitest --run --config vitest.acceptance.config.ts",
		"check": "biome check . && tsc --noEmit",
		"format": "biome check --write ."
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"dependencies": {
		"typebox": "^1.1.38",
		"ws": "^8.18.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "0.82.1",
		"@earendil-works/pi-tui": "0.82.1",
		"@types/node": "24.12.4",
		"@types/ws": "8.18.1",
		"typebox": "1.1.38",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	}
}
