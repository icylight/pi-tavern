{
	// RH3 首部剧本（私信投影验收断言，剧本驱动 e2e MVP v0）
	// 场景：Alice 私信 Carol → 创建者完整正文 / 接收者实时正文 / 旁观者占位
	// 恢复：重启 resume 后创建者仍见完整正文（WH8 恢复投影）
	"scenario": "RH3-whisper-projection",
	"channel": "protocol",
	"roles": {
		"alice": "characters/dev.md",
		"carol": "characters/qa.md",
		"bystander": "characters/arch.md"
	},
	"steps": [
		{
			// 开场：User Persona 消息开启讨论轮次（创建者测试命令，协议层无 persona 方法）
			"act": "persona",
			"sender": "creator",
			"content": "开场：本轮讨论私信投影",
			"expect": []
		},
		{
			// 公开消息打底：真实序号 2（persona 开场消息占 seq1，见 whisper-flow 先例）
			"act": "speak",
			"sender": "alice",
			"content": "开场公开消息",
			"sequence": 2,
			"expect": [
				{ "observer": "creator", "kind": "public_message", "content_contains": "开场公开消息", "sequence": 2 }
			]
		},
		{
			// 私信：Alice 悄悄话 Carol（真实序号 3）
			"act": "whisper",
			"sender": "alice",
			"recipient": "carol",
			"content": "悄悄话R1",
			"sequence": 3,
			"expect": [
				// 创建者：完整正文投影（kind whisper_message + 正文）
				{ "observer": "creator", "kind": "whisper_message", "content_contains": "悄悄话R1", "sequence": 3 },
				// 接收者 Carol：实时收到正文
				{ "observer": "carol", "frame": "whisper_message", "content_contains": "悄悄话R1", "sequence": 3 },
				// 旁观者 bystander：仅占位、无正文（WH6 不唤醒）
				{ "observer": "bystander", "frame": "whisper_placeholder", "content_absent": true, "sequence": 3 }
			]
		}
	],
	"recovery": {
		// 重启恢复：创建者 resume 后历史私信仍见完整正文（RH3 验收点）
		"restart": true,
		"expect": [
			{ "observer": "creator", "kind": "whisper_message", "content_contains": "悄悄话R1", "sequence": 3 }
		]
	}
}
